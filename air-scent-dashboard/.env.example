# LLM — 로컬 Qwen3 1.7B (Ollama, Jetson). 클라우드 NIM으로 되돌릴 때는
# NIM_BASE_URL 줄을 지우고 NIM_MODEL=google/gemma-4-31b-it 로 바꾸세요.
NVIDIA_API_KEY=your-nvapi-key-here
NIM_BASE_URL=http://127.0.0.1:11434/v1
NIM_MODEL=scent-qwen3

# STT (faster-whisper 로컬 — NIM HTTP ASR 미지원)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
STT_LANGUAGE=ko

# TTS (향기 추천 AI 대사 → 스피커)
# python3 -m pip install --user edge-tts
TTS_VOICE=ko-KR-SunHiNeural
TTS_RATE=-8%
TTS_LANGUAGE=ko

# MQTT (HiveMQ Cloud) — 실제 값은 .env.local 에
MQTT_BROKER=your-cluster-id.s1.eu.hivemq.cloud
MQTT_BROKER_LAVENDER=your-cluster-id.s1.eu.hivemq.cloud
MQTT_USER=your-mqtt-username
MQTT_PASS=your-mqtt-password
